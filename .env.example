GOOGLE_CREDENTIALS=C:\path\to\service-account.json
GOOGLE_DRIVE_ROOT_FOLDER_ID=google-drive-folder-id
LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
BOT_TOKEN=
BITRIX_BASE_URL=https://your-portal.bitrix24.ru/rest/1/your-webhook-token/

# Authorization (Allowed Telegram IDs, comma-separated)
AUTHORIZED_USERS=123456789, 987654321

# Schedule Tracker Settings
SCHEDULE_ENABLED=true
SCHEDULE_SHEET_ID=your_schedule_sheet_id
SCHEDULE_MANAGER_NAME=Manager Name
SCHEDULE_POLL_INTERVAL=60
SCHEDULE_TIMEZONE=Europe/Moscow
SCHEDULE_NOTIFICATION_START_TIME=09:00
SCHEDULE_NOTIFICATION_END_TIME=20:00

# Offers Engine Settings
OFFERS_ENABLED=true
OFFERS_SHEET_ID=your_offers_sheet_id
OFFERS_POLL_INTERVAL=300
OFFERS_SAMOKAT_SHEET=Sheet1
OFFERS_LAVKA_SHEET=Sheet2

# Google OAuth 2.0 User Credentials (used when Google Sheet cannot be shared with Service Account)
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_OAUTH_REFRESH_TOKEN=your_google_oauth_refresh_token

